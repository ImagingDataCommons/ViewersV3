+/**
+ * Validates and normalizes a VOI LUT function value.
+ * Falls back to LINEAR for invalid/undefined values with a warning.
+ * Aligned with upstream cornerstone3D PR #2856.
+ */
+const warnedValues = new Set();
+function getValidVOILUTFunction(value) {
+    if (value === VOILUTFunctionType.LINEAR ||
+        value === VOILUTFunctionType.LINEAR_EXACT ||
+        value === VOILUTFunctionType.SAMPLED_SIGMOID ||
+        value === 'LINEAR' ||
+        value === 'LINEAR_EXACT' ||
+        value === 'SIGMOID') {
+        return value === 'SIGMOID' ? VOILUTFunctionType.SAMPLED_SIGMOID : value;
+    }
+    if (value && typeof value === 'string' && value.trim() !== '') {
+        const key = String(value).trim();
+        if (!warnedValues.has(key)) {
+            warnedValues.add(key);
+            console.warn(`Unsupported VOI LUT Function "${key}", falling back to LINEAR`);
+        }
+    }
+    return VOILUTFunctionType.LINEAR;
+}
